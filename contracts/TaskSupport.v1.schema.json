  "properties": {
    "explanation": {
      "type": "string"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisite": {
      "type": "string"
    },
    "worked_example": {
      "type": "string"
    }
  },
