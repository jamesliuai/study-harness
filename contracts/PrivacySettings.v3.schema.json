{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivacySettings",
  "type": "object",
  "properties": {
    "reasoning_effort": {
      "type": "string",
      "default": "low"
    },
    "retain_failed_audio": {
      "type": "boolean"
    },
    "review_minutes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "text_scale_percent": {
      "type": "integer",
      "format": "uint32",
      "default": 100,
      "minimum": 0
    },
    "tutor_model": {
      "type": "string",
      "default": "gpt-6.1-sol"
    }
  },
  "additionalProperties": false,
  "required": [
    "retain_failed_audio",
    "review_minutes"
  ]
}