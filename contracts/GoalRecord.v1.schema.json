{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalRecord",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "passage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "text",
    "created_at",
    "origin",
    "source_ids",
    "passage_ids"
  ]
}