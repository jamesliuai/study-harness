{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attempt",
  "type": "object",
  "properties": {
    "activity_id": {
      "type": "string"
    },
    "assistance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "exposure_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string"
    },
    "modality": {
      "type": "string"
    },
    "recognized_transcript": {
      "type": [
        "string",
        "null"
      ]
    },
    "response": {
      "type": "string"
    },
    "revision_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "session_id": {
      "type": "string"
    },
    "task_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "activity_id",
    "task_version",
    "response",
    "modality",
    "created_at",
    "assistance_ids",
    "exposure_ids"
  ]
}