{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeProposal",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RubricFinding"
      }
    },
    "uncertainty": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings",
    "uncertainty"
  ],
  "$defs": {
    "RubricFinding": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "dimension",
        "result",
        "excerpt"
      ]
    }
  }
}