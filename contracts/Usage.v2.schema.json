{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Usage",
  "type": "object",
  "properties": {
    "audio_seconds": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "cost_microusd": {
      "type": "integer",
      "format": "int32"
    },
    "cost_status": {
      "type": "string"
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "provider": {
      "type": "string"
    },
    "rate_version": {
      "type": "string"
    },
    "reported_model": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "request_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "model",
    "cost_microusd",
    "cost_status",
    "rate_version",
    "status"
  ]
}