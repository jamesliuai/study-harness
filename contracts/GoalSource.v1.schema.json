{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalSource",
  "type": "object",
  "properties": {
    "excerpt": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "warnings",
    "excerpt"
  ]
}