{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string"
    },
    "draft": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "int32"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "revision",
    "created_at",
    "draft"
  ]
}