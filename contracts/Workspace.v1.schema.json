{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace",
  "type": "object",
  "properties": {
    "active_session_id": {
      "type": "string"
    },
    "activity": {
      "$ref": "#/$defs/Activity"
    },
    "assistance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assistance"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Attempt"
      }
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "credential": {
      "$ref": "#/$defs/CredentialStatus"
    },
    "provider_model": {
      "type": "string"
    },
    "rate_version": {
      "type": "string"
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Request"
      }
    },
    "scene": {
      "$ref": "#/$defs/SceneSpec"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Session"
      }
    },
    "transcription_model": {
      "type": "string"
    },
    "usage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Usage"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sessions",
    "active_session_id",
    "activity",
    "attempts",
    "assistance",
    "requests",
    "usage",
    "budget",
    "credential",
    "scene",
    "provider_model",
    "transcription_model",
    "rate_version"
  ],
  "$defs": {
    "Activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "math": {
          "type": "string"
        },
        "objective_id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "task_family": {
          "type": "string"
        },
        "validation_status": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "session_id",
        "objective_id",
        "version",
        "prompt",
        "math",
        "task_family",
        "rubric_version",
        "validation_status"
      ]
    },
    "Assistance": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "depth": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "visible_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "session_id",
        "activity_id",
        "content",
        "depth",
        "visible_at"
      ]
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "string"
        },
        "assistance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        },
        "exposure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "recognized_transcript": {
          "type": [
            "string",
            "null"
          ]
        },
        "response": {
          "type": "string"
        },
        "revision_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "task_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "session_id",
        "activity_id",
        "task_version",
        "response",
        "modality",
        "created_at",
        "assistance_ids",
        "exposure_ids"
      ]
    },
    "Budget": {
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "month": {
          "type": "string"
        },
        "month_spent_microusd": {
          "type": "integer",
          "format": "int32"
        },
        "session_spent_microusd": {
          "type": "integer",
          "format": "int32"
        },
        "unresolved_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "session_spent_microusd",
        "month_spent_microusd",
        "unresolved_count",
        "limits",
        "month"
      ]
    },
    "CredentialStatus": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "masked": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "configured",
        "storage",
        "masked",
        "message"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "monthly_microusd": {
          "type": "integer",
          "format": "int32"
        },
        "session_microusd": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_microusd",
        "monthly_microusd"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "reserved_microusd": {
          "type": "integer",
          "format": "int32"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "session_revision": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "session_id",
        "session_revision",
        "kind",
        "status",
        "reserved_microusd",
        "created_at"
      ]
    },
    "SceneParameters": {
      "type": "object",
      "properties": {
        "curvature": {
          "type": "number",
          "format": "double"
        },
        "start": {
          "type": "number",
          "format": "double"
        },
        "step_size": {
          "type": "number",
          "format": "double"
        },
        "steps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "curvature",
        "step_size",
        "start",
        "steps"
      ]
    },
    "SceneSpec": {
      "type": "object",
      "properties": {
        "accessibility": {
          "type": "string"
        },
        "activity_id": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capability_version": {
          "type": "string"
        },
        "follow_up": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "objective_id": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/SceneParameters"
        },
        "prediction": {
          "type": "string"
        },
        "revealed": {
          "type": "boolean"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "validation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability_version",
        "model_id",
        "model_version",
        "objective_id",
        "activity_id",
        "parameters",
        "prediction",
        "follow_up",
        "assumptions",
        "validation",
        "accessibility",
        "revealed"
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int32"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "title",
        "revision",
        "created_at",
        "draft"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "audio_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cost_microusd": {
          "type": "integer",
          "format": "int32"
        },
        "cost_status": {
          "type": "string"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "provider": {
          "type": "string"
        },
        "rate_version": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "provider",
        "model",
        "cost_microusd",
        "cost_status",
        "rate_version",
        "status"
      ]
    }
  }
}