{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceDocument",
  "type": "object",
  "properties": {
    "extraction_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "imported_at": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "page_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sha256": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "sha256",
    "title",
    "kind",
    "extraction_version",
    "page_count",
    "warnings",
    "imported_at"
  ]
}