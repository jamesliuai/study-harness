{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceView",
  "type": "object",
  "properties": {
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceCitation"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceDocument"
      }
    },
    "selected_passage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "documents",
    "selected_passage_ids",
    "citations"
  ],
  "$defs": {
    "SourceCitation": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string"
        },
        "assistance_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "assistance_id",
        "source_id",
        "chunk_id",
        "title",
        "anchor",
        "excerpt",
        "kind"
      ]
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "extraction_version": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "imported_at": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "page_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "sha256",
        "title",
        "kind",
        "extraction_version",
        "page_count",
        "warnings",
        "imported_at"
      ]
    }
  }
}