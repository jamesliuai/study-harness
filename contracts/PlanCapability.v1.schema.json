{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanCapability",
  "type": "object",
  "properties": {
    "assessment": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "minutes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "note": {
      "type": "string"
    },
    "objective_id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "visual": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanVisual"
        },
        {
          "type": "null"
        }
      ]
    },
    "why": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "objective_id",
    "key",
    "outcome",
    "why",
    "status",
    "minutes",
    "assessment",
    "origin",
    "prerequisites",
    "note"
  ],
  "$defs": {
    "PlanVisual": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisualParameter"
          }
        },
        "purpose": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "template_id",
        "parameters",
        "purpose"
      ]
    },
    "VisualParameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    }
  }
}